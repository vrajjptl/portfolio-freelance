# .env.example
# -------------------------------------------------
# Environment variables used by the portfolio site.
# Copy this file to .env and fill in the values.
# Do NOT commit the real .env file.

# WhatsApp number (without + sign) used for the CTA links
VITE_WHATSAPP_NUMBER=917414912464

# Your contact email address (used for the mailto link)
VITE_EMAIL=vrajpatil9891@gmail.com

# Backend endpoint for the contact form (Netlify or Vercel). Example:
#   Netlify: /.netlify/functions/contact
#   Vercel:  /api/contact
# If you don't have a serverless function, leave blank – the form will just log to console.
VITE_CONTACT_ENDPOINT=

# (Optional) SendGrid/Mailgun API key – used ONLY in the serverless function.
# Do NOT expose this in the client .env file.
SENDGRID_API_KEY=
